{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>brave/renovate-config",
    "local>brave/renovate-config:enable-vulnerability-alerts"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "enabled": true
    },
    {
      "groupName": "puppeteer",
      "matchPackageNames": [
        "puppeteer-core",
        "rebrowser-patches"
      ]
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/testcases/**",
    "**/__fixtures__/**"
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
